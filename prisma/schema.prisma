// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  login     String?  @unique
  firstName String
  lastName  String
  role      Role     @default(STUDENT)
  password  String
  isActive  Boolean  @default(false)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  teachingGroups Group[]  @relation("TeacherGroups")
  studentGroups  Group[]  @relation("StudentGroups")
  lessons        Lesson[] @relation("TeacherLessons")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  level     String
  
  teacherId String?
  teacher   User?    @relation("TeacherGroups", fields: [teacherId], references: [id])
  
  students  User[]   @relation("StudentGroups")
  
  lessons   Lesson[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id        String   @id @default(uuid())
  title     String
  start     DateTime
  end       DateTime
  
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])
  
  teacherId String?
  teacher   User?    @relation("TeacherLessons", fields: [teacherId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
